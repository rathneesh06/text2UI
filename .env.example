# --- text2UI environment template — copy to .env; NEVER commit .env ---

# REQUIRED: Google Gemini API key (server-side only; never exposed to the browser)
GEMINI_API_KEY=

# Model + generation tuning (optional)
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_BUDGET=
GEMINI_PLAN_TIMEOUT_MS=

# Cost-estimate rates (USD per 1M tokens). Token counts are exact regardless of these.
GEMINI_PRICE_INPUT_PER_M=0.3
GEMINI_PRICE_OUTPUT_PER_M=2.5

# --- Server ---
PORT=8787
NODE_ENV=development
BODY_LIMIT=64mb
# Comma-separated CORS allowlist. Empty = open (fine in dev; warned in production).
ALLOWED_ORIGINS=
# Bearer-token-per-tenant auth: "tenantA:tokenA,tenantB:tokenB". Empty = auth disabled (dev; warned in prod).
AUTH_TOKENS=

# --- Per-tenant rate limits + quotas (all disabled unless set) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=0          # max requests per window per tenant (0 = off)
QUOTA_WINDOW_MS=86400000  # 24h
QUOTA_MAX_TOKENS=0        # max tokens per tenant per quota window (0 = off)
QUOTA_MAX_COST_USD=0      # max estimated cost per tenant per quota window (0 = off)

# --- Storage --- "duckdb" (default) or "postgres" (Postgres is required for Design Retrieval later)
STORAGE=duckdb
STORAGE_PATH=
PG_URL=

# --- Read-only query limits (/api/query) ---
QUERY_ROW_CAP=
QUERY_ROW_CAP_MAX=
QUERY_TIMEOUT_MS=

# --- markitdown sidecar (document -> Markdown input conversion) ---
MARKITDOWN_URL=
MARKITDOWN_TIMEOUT_MS=

# --- Tailwind CLI (sandbox CSS compile) ---
TAILWIND_CLI_PATH=
TAILWIND_COMPILE_TIMEOUT_MS=

# --- Frontend (set these in the frontend's own env, not the BFF's) ---
# VITE_BFF_URL=http://localhost:8787
# VITE_REMOTE_DATA=0
# VITE_AUTH_TOKEN=   # the tenant token this frontend sends as Authorization: Bearer

# --- Design Retrieval (design-RAG) ---
DESIGN_RAG_ENABLED=0          # 1 to inject retrieved design references into build prompts
DESIGN_EMBED_MODEL=gemini-embedding-2
DESIGN_EMBED_DIM=768          # Matryoshka-truncated; MUST match the _design_refs vector() width
DESIGN_RAG_K=3                # top-K references per build
DESIGN_RAG_MIN_QUALITY=0.6    # P7 score floor to enroll AND to retrieve
DESIGN_RAG_CORPUS_DIR=bff/design-rag/corpus   # where reference PNGs are stored on disk
DESIGN_RAG_PHASH_MAX_HAMMING=5               # perceptual-dedup tolerance (0-64 bits)
DESIGN_RAG_RETIRE_MIN_QUALITY=0.6            # retire generations below this quality (seeds exempt)
# --- Curated design references ---
# A hand-picked folder that runs IN FRONT of pgvector retrieval: when it yields
# images they are used and retrieval is skipped; when it yields nothing the RAG
# path runs exactly as before. Leave DESIGN_REFS_ENABLED=0 until a human has
# curated the folder — the renderer populates it, it does not vet it.
DESIGN_REFS_ENABLED=0                          # 1 to use the curated set
DESIGN_REFS_DIR=bff/design-rag/references      # curated PNGs, NOT corpus/
DESIGN_REFS_K=3                                # how many to attach (3-4 max)
DESIGN_FAMILY=editorial                        # editorial | modern

DESIGN_RAG_RETIRE_GRACE_DAYS=30              # retire refs never retrieved after N days
DESIGN_RAG_RENDER_CONCURRENCY=2              # max concurrent headless renders
DESIGN_RAG_RENDER_IDLE_MS=30000              # close shared browser after N ms idle (0=keep open)

# --- Table selection (/select) ---
T2SQL_SELECT_CATALOG_N=250          # tables described to the model per turn
T2SQL_SELECT_TIMEOUT_MS=25000       # planner timeout
T2SQL_SELECT_OFFLINE=1              # bare-number fallback when the model is down
T2SQL_PROFILE_BATCH=12              # tables per /profile call
SELECTION_PG_TIMEOUT_MS=8000        # selection store queries

# --- Native DB browsing + analyst chat ---
DB_NATIVE_CONNECT_TIMEOUT_MS=8000
DB_NATIVE_QUERY_TIMEOUT_MS=15000
DB_ANALYSIS_ROW_CAP=200             # analyst-chat row cap
DB_ANALYSIS_TIMEOUT_MS=20000        # analyst-chat statement timeout

# --- Analysts. THREE separate subsystems. Do not cross-tune. ---
# Build path (analyst.ts): decomposes a build request into sub-questions and
# runs them in parallel on the LIVE attach to produce the spec planner's evidence.
T2SQL_ANALYST_CONCURRENCY=4
T2SQL_ANALYST_MAX_ROWS=1000

# /select chat (interpret.ts): queries whatever production database a user
# pasted a connection string for. Stays tight on purpose.
T2SQL_SELECT_MAX_QUERIES=3
T2SQL_SELECT_MAX_ROUNDS=2
T2SQL_SELECT_BUDGET_MS=45000
# /select transcripts are held in memory only — they are composed from live row
# values and must not be persisted. Idle conversations are swept after this long.
T2SQL_SELECT_CHAT_TTL_MS=3600000

# Main build chat (interpret.ts via handleSourceChat): queries the local DuckDB
# snapshot, where an extra query costs milliseconds. Looser on purpose.
T2SQL_SOURCE_MAX_QUERIES=5
T2SQL_SOURCE_MAX_ROUNDS=3
T2SQL_SOURCE_BUDGET_MS=60000
WB_CONN_TTL_MS=14400000             # connection registry idle TTL (4h)